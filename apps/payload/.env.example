# Figma Project ID (CMS Resource ID)
FIGMA_PROJECT_ID=4e3f3721-aba0-4513-a33d-38c56be0a61c

# Infrastructure safety boundary. This must remain staging.
FIGMA_INFRA_ENV=staging
FIGMA_API_BASE_URL=https://api.staging.figma.com
FIGMA_WEB_BASE_URL=https://staging.figma.com
FIGMA_CONTENT_API_URL=https://us-east-1.cms-tenants-001-staging.figmacontentstaging.com

# The first tenant environment is named "production" even on staging infrastructure.
FIGMA_ENVIRONMENT_NAME=production

# Bootstrap admin for this staging-only workspace. Store the real address as a
# sensitive environment variable rather than hard-coding it in the application.
FORECAST_OWNER_EMAIL=

# Server-only live integrations. Configure these as encrypted staging secrets;
# never expose them through VITE_* variables or commit their values.
ASANA_ACCESS_TOKEN=
ASANA_MARKETING_CALENDAR_GID=1154318831778057

# Two-provider boundary. Keep staging on POC until the approved Snowflake OAuth
# or internal API implementation is connected and reviewed.
FORECAST_DATA_MODE=poc

# Legacy Hex snapshot transport remains hard-disabled by default. Do not enable
# without explicit Security and data-governance approval.
HEX_INGEST_ENABLED=false
HEX_SYNC_SECRET=
